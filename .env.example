# Express и PostgreSQL
PORT=5000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=itd_awards
DB_USER=
DB_PASSWORD=
PUBLIC_ORIGIN=http://localhost:5000
# CORS_ORIGINS=http://localhost:5173
# TRUST_PROXY=loopback

# Абсолютный путь вне репозитория. Без него используется PostgreSQL.
# MEDIA_STORAGE_DIR=/var/lib/itd-awards/media
# Включайте только после проверки файлового хранилища и процедуры отката.
# MEDIA_FILE_ONLY=0
# Включайте после настройки внутреннего location в Nginx.
# MEDIA_NGINX_ACCEL=0

# Вход на сайт. Два разных случайных значения длиной от 32 символов.
TELEGRAM_BOT_USERNAME=
BOT_API_TOKEN=
AUTH_CODE_SECRET=

# Telegram
BOT_TOKEN=
# Настройки автономного режима с SQLite.
# ADMIN_IDS=123456789
VOTE_SALT=
AWARDS_SITE_API_URL=http://localhost:5000
# По умолчанию бот использует общий каталог сайта. 0 включает прежний режим с SQLite.
# AWARDS_SITE_MANAGED=0
# AWARDS_SITE_LOGIN_URL=https://awards.example.org/sign-in
# DB_PATH=awards.db
# При переносе укажите прежний .env и удалите из этого файла дублирующие пустые переменные.
# BOT_ENV_FILE=C:/path/to/previous-bot/.env
# Для своего виртуального окружения можно указать полный путь к Python.
# PYTHON=C:/path/to/venv/Scripts/python.exe
