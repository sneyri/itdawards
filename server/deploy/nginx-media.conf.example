# Вставьте в HTTPS server {} существующего сайта. Сохраните настройки TLS
# и проверьте, что путь alias совпадает с MEDIA_STORAGE_DIR процесса Node.
#
# Nginx 1.24: listen 443 ssl http2;
# Nginx 1.25.1+: listen 443 ssl; http2 on;
# Используйте один вариант директив для установленной версии.

gzip on;
gzip_min_length 1024;
gzip_vary on;
gzip_types application/json application/javascript text/javascript text/css image/svg+xml;

location ~* ^/api/bot(?:/|$) {
    return 404;
}

location ^~ /_itd_media/ {
    internal;
    alias /var/lib/itd-awards/media/;
    sendfile on;
    disable_symlinks on;
    etag on;
    max_ranges 1;
    types {
        image/jpeg jpg;
        image/png png;
        image/webp webp;
        audio/mpeg mp3;
        audio/mp4 m4a;
        audio/wav wav;
        audio/ogg ogg;
        audio/webm webm;
    }
    default_type application/octet-stream;
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header Content-Security-Policy "sandbox; default-src 'none'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
}

location / {
    client_max_body_size 20m;
    proxy_pass http://127.0.0.1:5000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_cache off;
}
