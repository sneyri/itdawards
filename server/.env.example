PORT=5000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=itd_awards
DB_USER=
DB_PASSWORD=

# Публичный адрес сайта, без завершающего слэша.
PUBLIC_ORIGIN=http://localhost:5000
# Дополнительные разрешённые origin через запятую. Для обычного запуска оставьте пустым.
CORS_ORIGINS=
# TRUST_PROXY=loopback

# Публичное голосование без аккаунта.
# VOTING_MODE=anonymous
# ANONYMOUS_VOTER_SECRET=

# Заполните оба параметра, чтобы включить вход.
# AUTH_SERVICE_URL=http://127.0.0.1:5050
# AUTH_INTERNAL_SECRET=
# AUTH_AUTO_START=false  # Для сервиса входа, запущенного отдельно.

# База сервиса входа.
# AUTH_DB_HOST=127.0.0.1
# AUTH_DB_PORT=5432
# AUTH_DB_NAME=itd_awards_auth
# AUTH_DB_USER=
# AUTH_DB_PASSWORD=
# AUTH_ALLOWED_ORIGINS=http://localhost:5173

# Отправка кодов для входа.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
